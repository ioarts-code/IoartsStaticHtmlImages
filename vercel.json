{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/products/:category/:slug", "destination": "/product" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.ioarts.site" }],
      "destination": "https://ioarts.site/:path",
      "permanent": true
    }
  ],
  "errorPages": [
    { "source": "404", "destination": "/index.html" }
  ]
}
